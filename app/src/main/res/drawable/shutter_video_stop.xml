<?xml version="1.0" encoding="utf-8"?>
<!-- Video recording active shutter button: red outer ring, inner red square. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="@color/record_red" />
            <solid android:color="#33E53935" />
        </shape>
    </item>
    <item
        android:left="20dp"
        android:top="20dp"
        android:right="20dp"
        android:bottom="20dp">
        <shape android:shape="rectangle">
            <corners android:radius="4dp" />
            <solid android:color="@color/record_red" />
        </shape>
    </item>
</layer-list>
