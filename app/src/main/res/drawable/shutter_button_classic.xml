<?xml version="1.0" encoding="utf-8"?>
<!-- 1970s Classic Mechanical Shutter: Knurled chrome outer ring, satin silver disc, threaded red ruby core. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Knurled brushed chrome outer bezel -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="3.5dp"
                android:color="#FFE5E7EB" />
            <solid android:color="#2B000000" />
        </shape>
    </item>
    <!-- Dark milled mechanical gap -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#FF111113" />
        </shape>
    </item>
    <!-- Satin brushed chrome center release button -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#FFF9FAFB"
                android:centerColor="#FFE5E7EB"
                android:endColor="#FF9CA3AF" />
        </shape>
    </item>
    <!-- Soft-release mechanical screw core: iconic red enamel center -->
    <item
        android:left="25dp"
        android:top="25dp"
        android:right="25dp"
        android:bottom="25dp">
        <shape android:shape="oval">
            <solid android:color="#FFDC2626" />
            <stroke
                android:width="1dp"
                android:color="#B3991B1B" />
        </shape>
    </item>
</layer-list>
