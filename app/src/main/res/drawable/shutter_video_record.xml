<?xml version="1.0" encoding="utf-8"?>
<!-- Video record shutter release: outer ring, red centre disc. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="3dp"
                android:color="@color/shutter_ring" />
            <solid android:color="#22000000" />
        </shape>
    </item>
    <item
        android:left="7dp"
        android:top="7dp"
        android:right="7dp"
        android:bottom="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/record_red" />
        </shape>
    </item>
</layer-list>
