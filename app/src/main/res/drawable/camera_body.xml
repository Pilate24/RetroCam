<?xml version="1.0" encoding="utf-8"?>
<!-- The bottom panel reads as the camera's body: a dark slab with a lit top edge, so the
     viewfinder above it feels like glass rather than the same flat surface. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/body" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
    <item android:bottom="1dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="@color/body_edge" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
</layer-list>
