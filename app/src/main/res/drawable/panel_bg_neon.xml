<?xml version="1.0" encoding="utf-8"?>
<!-- 1990s Translucent Neon: Transparent colorful plastic casing (iMac G3 / Game Boy Color) -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Semi-transparent vibrant atomic teal polycarbonate body -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E6004D5A"
                android:centerColor="#D9003842"
                android:endColor="#E6002027" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
    <!-- Internal structural frosted ribbing highlight -->
    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <stroke
                android:width="1dp"
                android:color="#4000E5FF" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
            <solid android:color="#00000000" />
        </shape>
    </item>
    <!-- Glowing neon cyan specular top lip -->
    <item
        android:height="3dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#8000E5FF"
                android:centerColor="#FF00E5FF"
                android:endColor="#8000E5FF" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
    <!-- Specular gloss refraction hairline -->
    <item
        android:height="1dp"
        android:gravity="top">
        <shape android:shape="rectangle">
            <solid android:color="#CCFFFFFF" />
            <corners
                android:topLeftRadius="22dp"
                android:topRightRadius="22dp" />
        </shape>
    </item>
</layer-list>
