<?xml version="1.0" encoding="utf-8"?>
<!-- Disposable Camera Shutter: Molded industrial plastic collar with high-contrast red grooved release button -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Molded dark camera plastic outer collar -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="4dp"
                android:color="#FF1F2937" />
            <solid android:color="#FF111827" />
        </shape>
    </item>
    <!-- Recessed collar bevel -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#FF000000" />
        </shape>
    </item>
    <!-- Injection-molded bright red plastic shutter button -->
    <item
        android:left="7dp"
        android:top="7dp"
        android:right="7dp"
        android:bottom="7dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#FFEF4444"
                android:centerColor="#FFDC2626"
                android:endColor="#FFB91C1C" />
        </shape>
    </item>
    <!-- Tactile molded plastic thumb-grip center ridge -->
    <item
        android:left="22dp"
        android:top="22dp"
        android:right="22dp"
        android:bottom="22dp">
        <shape android:shape="oval">
            <solid android:color="#FFFEE2E2" />
            <stroke
                android:width="2dp"
                android:color="#FFB91C1C" />
        </shape>
    </item>
</layer-list>
