<?xml version="1.0" encoding="utf-8"?>
<!-- Golden Brass Rangefinder Shutter: Knurled brass ring, antique gap, solid golden brass release with ivory threaded socket. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Polished knurled golden brass outer ring -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="3.5dp"
                android:color="#FFD4AF37" />
            <solid android:color="#33000000" />
        </shape>
    </item>
    <!-- Deep mechanical gap -->
    <item
        android:left="5dp"
        android:top="5dp"
        android:right="5dp"
        android:bottom="5dp">
        <shape android:shape="oval">
            <solid android:color="#FF241303" />
        </shape>
    </item>
    <!-- Solid polished golden brass release button -->
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="8dp"
        android:bottom="8dp">
        <shape android:shape="oval">
            <gradient
                android:angle="135"
                android:startColor="#FFFDE68A"
                android:centerColor="#FFD4AF37"
                android:endColor="#FF92631E" />
        </shape>
    </item>
    <!-- Threaded cable release coaxial socket in antique ivory / brass -->
    <item
        android:left="24dp"
        android:top="24dp"
        android:right="24dp"
        android:bottom="24dp">
        <shape android:shape="oval">
            <solid android:color="#FFFEF3C7" />
            <stroke
                android:width="1.5dp"
                android:color="#FF92631E" />
        </shape>
    </item>
</layer-list>
