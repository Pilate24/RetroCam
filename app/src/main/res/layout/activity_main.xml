<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Photo Mode ViewFinder (Custom AGSL Shader rendering) -->
    <SurfaceView
        android:id="@+id/viewFinder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:contentDescription="@string/viewfinder"
        android:focusable="true" />

    <!-- Video Mode ViewFinder (CameraX PreviewView) -->
    <androidx.camera.view.PreviewView
        android:id="@+id/videoPreviewView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <!-- Composition aid: interface only, never drawn into a capture. -->
    <com.retrocam.app.ui.GridOverlayView
        android:id="@+id/gridOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:background="@drawable/scrim_top" />

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:fitsSystemWindows="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="4dp"
        android:paddingEnd="10dp">

        <ImageButton
            android:id="@+id/flashButton"
            style="@style/TopBarButton"
            android:contentDescription="@string/flash"
            android:src="@drawable/ic_flash_off" />

        <ImageButton
            android:id="@+id/timerButton"
            style="@style/TopBarButton"
            android:contentDescription="@string/timer"
            android:src="@drawable/ic_timer" />

        <TextView
            android:id="@+id/aspectButton"
            style="@style/TopBarLabel"
            android:contentDescription="@string/aspect_ratio" />

        <TextView
            android:id="@+id/videoQualityButton"
            style="@style/TopBarLabel"
            android:layout_marginStart="6dp"
            android:contentDescription="Video quality and frame rate"
            android:visibility="gone" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Grid, compare and surprise live in here: reached less often than flash or timer. -->
        <ImageButton
            android:id="@+id/overflowButton"
            style="@style/TopBarButton"
            android:contentDescription="@string/more_options"
            android:src="@drawable/ic_more" />
    </LinearLayout>

    <TextView
        android:id="@+id/statusChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="76dp"
        android:alpha="0"
        android:background="@drawable/zoom_pill"
        android:fontFamily="monospace"
        android:letterSpacing="0.12"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:textAllCaps="true"
        android:textColor="@color/amber"
        android:textSize="11sp" />

    <!-- Video Recording Status Overlay -->
    <LinearLayout
        android:id="@+id/recordingIndicatorBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="76dp"
        android:background="@drawable/recording_pill_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="5dp"
        android:paddingEnd="14dp"
        android:paddingBottom="5dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/recordDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_record_dot" />

        <TextView
            android:id="@+id/recordStateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.1"
            android:text="@string/status_recording"
            android:textColor="@color/record_red"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recordTimerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="00:00"
            android:textColor="@color/readout"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/micStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/readout_bg"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:text="@string/audio_muted_badge"
            android:textColor="@color/amber"
            android:textSize="9sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/countdownLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:alpha="0"
        android:fontFamily="monospace"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="2"
        android:shadowRadius="10"
        android:textColor="@color/readout"
        android:textSize="76sp"
        android:textStyle="bold" />

    <View
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:alpha="0"
        android:background="@drawable/focus_ring" />

    <TextView
        android:id="@+id/zoomLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="112dp"
        android:alpha="0"
        android:background="@drawable/zoom_pill"
        android:fontFamily="monospace"
        android:paddingStart="14dp"
        android:paddingTop="5dp"
        android:paddingEnd="14dp"
        android:paddingBottom="5dp"
        android:textColor="@color/readout"
        android:textSize="13sp" />

    <!-- The camera body. Kept as short as it can be: every dp here covers live image. -->
    <LinearLayout
        android:id="@+id/cameraBody"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/camera_body"
        android:fitsSystemWindows="true"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="12dp">

        <!-- Film-counter readout. Tapping it reveals the intensity dial. -->
        <LinearLayout
            android:id="@+id/readoutRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/readout_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="3dp"
            android:paddingEnd="10dp"
            android:paddingBottom="3dp">

            <TextView
                android:id="@+id/intensityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.08"
                android:textAllCaps="true"
                android:textColor="@color/amber"
                android:textSize="11sp" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/intensitySlider"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="28dp"
            android:layout_marginEnd="28dp"
            android:contentDescription="@string/intensity"
            android:stepSize="0.05"
            android:value="1.0"
            android:valueFrom="0.0"
            android:valueTo="1.0"
            android:visibility="gone"
            app:labelBehavior="gone"
            app:thumbColor="@color/amber"
            app:trackColorActive="@color/amber"
            app:trackColorInactive="@color/amber_faint" />

        <!-- Pro / RAW Video Control Bar -->
        <HorizontalScrollView
            android:id="@+id/rawControlBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chipIso"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/pro_chip_bg"
                    android:fontFamily="monospace"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="ISO AUTO"
                    android:textColor="@color/readout"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipShutter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/pro_chip_bg"
                    android:fontFamily="monospace"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="S AUTO"
                    android:textColor="@color/readout"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipEv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/pro_chip_bg"
                    android:fontFamily="monospace"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="EV 0.0"
                    android:textColor="@color/readout"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipFocus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/pro_chip_bg"
                    android:fontFamily="monospace"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="FOCUS AF"
                    android:textColor="@color/readout"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipWb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/pro_chip_bg"
                    android:fontFamily="monospace"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="WB AUTO"
                    android:textColor="@color/readout"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chipAperture"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/pro_chip_bg"
                    android:fontFamily="monospace"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="f/1.8"
                    android:textColor="@color/readout_dim"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/buttonRawReset"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/pro_chip_bg"
                    android:fontFamily="monospace"
                    android:paddingStart="8dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="5dp"
                    android:text="@string/pro_reset"
                    android:textColor="@color/amber"
                    android:textSize="11sp" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Pro / RAW Adjustment Panel (Expands when a chip is tapped) -->
        <LinearLayout
            android:id="@+id/rawAdjustPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="14dp"
            android:background="@drawable/readout_bg"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/rawAdjustTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.08"
                    android:textColor="@color/amber"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/rawAutoButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/mode_pill_selected"
                    android:fontFamily="monospace"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:text="@string/pro_auto"
                    android:textColor="@android:color/black"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/rawCloseButton"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close"
                    android:padding="4dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    android:tint="@color/readout_dim" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/rawSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="2dp"
                app:labelBehavior="gone"
                app:thumbColor="@color/amber"
                app:trackColorActive="@color/amber"
                app:trackColorInactive="@color/amber_faint" />

            <!-- Presets horizontal scroll -->
            <HorizontalScrollView
                android:id="@+id/rawPresetsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/rawPresetsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Filters by category. Selection here only narrows the carousel below. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryTabs"
            android:layout_width="match_parent"
            android:layout_height="26dp"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <!-- The centred item is the active look; tapping any item scrolls it to centre. -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/filterCarousel"
            android:layout_width="match_parent"
            android:layout_height="74dp"
            android:layout_marginTop="6dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            android:overScrollMode="never" />

        <!-- Camera Mode Switcher: PHOTO / VIDEO / RAW VIDEO -->
        <LinearLayout
            android:id="@+id/modeSelector"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/zoom_pill"
            android:orientation="horizontal"
            android:padding="3dp">

            <TextView
                android:id="@+id/modePhoto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/mode_pill_selected"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp"
                android:text="@string/mode_photo"
                android:textColor="@android:color/black"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/modeVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp"
                android:text="@string/mode_video"
                android:textColor="@color/readout_dim"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/modeRawVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.1"
                android:paddingStart="14dp"
                android:paddingTop="4dp"
                android:paddingEnd="14dp"
                android:paddingBottom="4dp"
                android:text="@string/mode_raw_video"
                android:textColor="@color/readout_dim"
                android:textSize="11sp" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <ImageButton
                android:id="@+id/galleryButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/gallery_title"
                android:padding="10dp"
                android:src="@drawable/ic_gallery"
                android:tint="@color/readout" />

            <ImageButton
                android:id="@+id/pauseResumeButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="34dp"
                android:background="@drawable/zoom_pill"
                android:contentDescription="@string/pause_recording"
                android:padding="11dp"
                android:src="@drawable/ic_pause"
                android:tint="@color/amber"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/shutterButton"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/shutter_button"
                android:contentDescription="@string/shutter" />

            <ImageButton
                android:id="@+id/flipCameraButton"
                android:layout_width="46dp"
                android:layout_height="46dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="34dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/switch_camera"
                android:padding="10dp"
                android:src="@drawable/ic_camera_flip"
                android:tint="@color/readout" />
        </FrameLayout>

    </LinearLayout>

    <!-- Permission Denied Screen -->
    <LinearLayout
        android:id="@+id/permissionDeniedContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#E6000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:text="@string/permission_denied_title"
            android:textColor="@color/amber"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/permissionDeniedExplanation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/camera_permission_required"
            android:textColor="@color/readout"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/grantPermissionButton"
            style="@style/Widget.MaterialComponents.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/amber"
            android:fontFamily="monospace"
            android:text="@string/grant_permission"
            android:textColor="@android:color/black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openSettingsButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="@string/open_settings"
            android:textColor="@color/amber"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Camera Error / Initializing Overlay -->
    <LinearLayout
        android:id="@+id/cameraErrorContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#CC000000"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/cameraErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="@string/camera_init_error"
            android:textColor="@color/amber"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryCameraButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:text="Retry"
            android:textColor="@color/readout"
            app:strokeColor="@color/amber" />
    </LinearLayout>

</FrameLayout>
