<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/presetCard"
    android:layout_width="100dp"
    android:layout_height="96dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/thumb_frame"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="6dp">

    <ImageView
        android:id="@+id/presetIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:tint="@color/amber"
        android:contentDescription="Preset Icon"
        android:src="@drawable/ic_check_circle" />

    <TextView
        android:id="@+id/presetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/presetSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#88FFFFFF"
        android:textSize="10sp" />

</LinearLayout>
