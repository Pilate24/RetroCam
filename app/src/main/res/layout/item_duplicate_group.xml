<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/trip_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Group Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/duplicateReasonText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/duplicateReclaimableText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/readout_bg"
            android:fontFamily="monospace"
            android:paddingStart="8dp"
            android:paddingTop="2dp"
            android:paddingEnd="8dp"
            android:paddingBottom="2dp"
            android:textColor="@color/amber"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Horizontal scroll of matching media items in this group -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/duplicateItemsRecycler"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:overScrollMode="never" />

</LinearLayout>
