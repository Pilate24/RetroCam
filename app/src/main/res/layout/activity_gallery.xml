<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B0B0B"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Top Action Bar -->
    <FrameLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FF111111">

        <!-- Normal Header View -->
        <LinearLayout
            android:id="@+id/normalHeaderView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/headerTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="Smart Library"
                android:textColor="#FFFFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSearch"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/btnFilterSort"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Sort and Filter"
                android:src="@drawable/ic_filter"
                app:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/btnSelectMode"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Select"
                android:src="@drawable/ic_check_circle"
                app:tint="#FFFFFFFF" />

            <ImageButton
                android:id="@+id/btnMoreMenu"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/more_options"
                android:src="@drawable/ic_more"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

        <!-- Search Bar View (Visible when search is active) -->
        <LinearLayout
            android:id="@+id/searchBarView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCloseSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close Search"
                android:src="@drawable/ic_back"
                app:tint="#FFFFFFFF" />

            <EditText
                android:id="@+id/searchEditText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search dates, ISO, photos, videos..."
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="#FFFFFFFF"
                android:textColorHint="#77FFFFFF"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/btnClearSearch"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Clear"
                android:src="@drawable/ic_close"
                android:visibility="gone"
                app:tint="#FFFFFFFF" />
        </LinearLayout>

        <!-- Selection Mode Header (Visible when multi-selection is active) -->
        <LinearLayout
            android:id="@+id/selectionHeaderView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnCloseSelection"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Cancel Selection"
                android:src="@drawable/ic_close"
                app:tint="#FFFFFFFF" />

            <TextView
                android:id="@+id/selectionCountText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="0 selected"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnSelectAll"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="Select All"
                android:src="@drawable/ic_select_all"
                app:tint="@color/amber" />
        </LinearLayout>
    </FrameLayout>

    <!-- Quick Category Tabs (Horizontal Scroll) -->
    <HorizontalScrollView
        android:id="@+id/categoryTabsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FF111111"
        android:overScrollMode="never"
        android:paddingStart="8dp"
        android:paddingTop="6dp"
        android:paddingEnd="8dp"
        android:paddingBottom="8dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/categoryTabsContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/category_pill_selected"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="All"
                android:textColor="@color/amber"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabPhotos"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/readout_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Photos"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tabVideos"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/readout_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Videos"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tabFavorites"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/readout_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Favorites"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tabAlbums"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/readout_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Albums"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tabEdited"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/readout_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="Edited"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Permission / Scope Notice Banner -->
    <LinearLayout
        android:id="@+id/permissionBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#26E8A33D"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/permissionBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Showing RetroCam media only. Grant access to view all device photos."
            android:textColor="@color/amber"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnGrantPermission"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Grant"
            android:textColor="@color/amber"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Indexing Progress Indicator -->
    <ProgressBar
        android:id="@+id/indexingProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- Media Grid / Albums Grid & Empty State -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/photoGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="2dp"
            android:scrollbars="vertical" />

        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginBottom="16dp"
                android:contentDescription="Empty"
                android:src="@drawable/ic_gallery"
                app:tint="#55FFFFFF" />

            <TextView
                android:id="@+id/emptyStateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/gallery_empty"
                android:textColor="#99FFFFFF"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEmptyCapture"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/amber"
                android:text="Capture Photo / Video"
                android:textColor="#FF000000"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Selection Mode Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/selectionActionBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#FF161616"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/btnShareSelected"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Share Selected"
            android:src="@drawable/ic_share"
            app:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/btnFavoriteSelected"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Favorite Selected"
            android:src="@drawable/ic_favorite_border"
            app:tint="@color/amber" />

        <ImageButton
            android:id="@+id/btnAddToAlbumSelected"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Add to Album"
            android:src="@drawable/ic_add"
            app:tint="#FFFFFFFF" />

        <ImageButton
            android:id="@+id/btnDeleteSelected"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Delete Selected"
            android:src="@drawable/ic_delete"
            app:tint="#FFE53935" />
    </LinearLayout>

</LinearLayout>
