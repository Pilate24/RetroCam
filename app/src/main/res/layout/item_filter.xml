<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed width: the carousel centres items by padding both ends with (width - itemWidth) / 2,
     which only lands exactly on centre when every item is the same size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/filter_item_width"
    android:layout_height="match_parent"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/filterThumb"
        android:layout_width="@dimen/filter_thumb_size"
        android:layout_height="@dimen/filter_thumb_size"
        android:background="#33FFFFFF"
        android:contentDescription="@null"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/filterName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="4"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
