<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed width: the carousel centres items by padding both ends with (width - itemWidth) / 2,
     which only lands exactly on centre when every item is the same size. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/filter_item_width"
    android:layout_height="match_parent"
    android:background="?android:attr/selectableItemBackground"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/filterThumbFrame"
        android:layout_width="@dimen/filter_thumb_size"
        android:layout_height="@dimen/filter_thumb_size"
        android:background="@drawable/thumb_frame"
        android:padding="2dp">

        <ImageView
            android:id="@+id/filterThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#22FFFFFF"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <TextView
        android:id="@+id/filterName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:gravity="center"
        android:maxLines="1"
        android:textSize="9sp" />
</LinearLayout>
