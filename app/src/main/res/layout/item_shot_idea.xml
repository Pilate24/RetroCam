<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/trip_card_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ideaNumber"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@drawable/mode_pill_selected"
            android:fontFamily="monospace"
            android:gravity="center"
            android:text="1"
            android:textColor="@android:color/black"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ideaName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:fontFamily="monospace"
            android:text="Tight Expression Shot"
            android:textColor="@color/amber"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/ideaVisualEffect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="monospace"
        android:text="Isolates facial emotion and expressions with soft background"
        android:textColor="@color/readout"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ideaLensChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/readout_bg"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="LENS: Main"
            android:textColor="@color/amber"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/ideaZoomChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:background="@drawable/readout_bg"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="ZOOM: 1.5×"
            android:textColor="@color/amber"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/ideaAspectChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/readout_bg"
            android:fontFamily="monospace"
            android:paddingStart="6dp"
            android:paddingTop="2dp"
            android:paddingEnd="6dp"
            android:paddingBottom="2dp"
            android:text="ASPECT: 4:5"
            android:textColor="@color/amber"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/ideaPosition"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="monospace"
        android:text="📍 Hold at eye level; fill frame with head and shoulders"
        android:textColor="@color/readout"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/ideaTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:text="💡 Position eyes along the upper horizontal third line."
        android:textColor="@color/amber"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/ideaExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="monospace"
        android:text="🔍 Tighter framing emphasizes facial nuances."
        android:textColor="@color/readout_dim"
        android:textSize="10sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/ideaApplyButton"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="8dp"
        android:backgroundTint="@color/amber"
        android:fontFamily="monospace"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:letterSpacing="0.06"
        android:text="APPLY THIS SHOT"
        android:textColor="@android:color/black"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>
