<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/photoItemContainer"
    android:layout_width="match_parent"
    android:layout_height="120dp"
    android:layout_margin="1dp"
    android:background="#FF161616"
    android:foreground="?android:attr/selectableItemBackground">

    <ImageView
        android:id="@+id/photoThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/photo"
        android:scaleType="centerCrop" />

    <!-- Top Badges: Favorite & Edited -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <TextView
            android:id="@+id/editedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#D9E8A33D"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="4dp"
            android:paddingTop="1dp"
            android:paddingEnd="4dp"
            android:paddingBottom="1dp"
            android:text="EDITED"
            android:textColor="#FF000000"
            android:textSize="8sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/favoriteBadge"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="Favorite"
            android:src="@drawable/ic_favorite"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom Badge displayed on video items -->
    <TextView
        android:id="@+id/videoBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:background="@drawable/readout_bg"
        android:fontFamily="monospace"
        android:gravity="center_vertical"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:textColor="@color/amber"
        android:textSize="10sp"
        android:visibility="gone" />

    <!-- Selection Overlay & Checkbox -->
    <View
        android:id="@+id/selectionDimOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/selectionCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/readout_bg"
        android:padding="2dp"
        android:src="@drawable/ic_check"
        android:tint="@color/amber"
        android:visibility="gone" />

</FrameLayout>
